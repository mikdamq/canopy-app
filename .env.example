# Copy to .env.local for local development, and add the same values in Netlify
# (Site configuration → Environment variables). Everything is optional: without
# them the form still works and requests are printed to the server log.

# Public
# The live address, e.g. https://laminafarm.app. Used for share previews,
# canonical links and the sitemap. Leave empty until the domain is chosen.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=hello@laminafarm.app
# WhatsApp number for the "Chat on WhatsApp" buttons, with country code. Leave the
# line out (or empty) to use the default (+962 78 7016 351); set it to "none" to hide the buttons.
# NEXT_PUBLIC_WHATSAPP_NUMBER=962787016351
# Your Cal.com or Calendly link, e.g. https://cal.com/your-name/30min
NEXT_PUBLIC_BOOKING_URL=

# Analytics (both optional; nothing loads until they're set)
# Umami: cookie-free visit counts and funnel events. cloud.umami.is → Settings → Websites
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only change this if you self-host Umami
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# Microsoft Clarity: heatmaps and recordings, loaded only after the visitor clicks "Allow".
# clarity.microsoft.com → your project → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=

# Database: Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email via SMTP. Works with your cPanel mailbox (Namecheap Private Email or cPanel email):
#   host: the outgoing server cPanel shows (Email Accounts → Connect Devices), port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lamina <hello@laminafarm.app>"
# Where new requests are sent (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
REQUESTS_NOTIFY_EMAIL=
