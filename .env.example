# Copy to .env.local for local development, and add the same values in Vercel
# (Project → Settings → Environment Variables). Everything is optional: without
# them the form still works and requests are printed to the server log.

# Public
NEXT_PUBLIC_CONTACT_EMAIL=info@mikdam.com
# Your Cal.com or Calendly link, e.g. https://cal.com/your-name/30min
NEXT_PUBLIC_BOOKING_URL=

# Database: Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email via SMTP. Works with your cPanel mailbox (Namecheap Private Email or cPanel email):
#   host: mail.yourdomain.com (or mail.privateemail.com), port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Canopy <hello@yourdomain.com>"
# Where new requests are sent (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
REQUESTS_NOTIFY_EMAIL=
